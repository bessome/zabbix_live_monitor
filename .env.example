# Copy to .env and set unique values. .env is ignored by Git.
APP_SECRET_KEY=replace-with-at-least-32-random-characters
ADMIN_PASSWORD=replace-with-at-least-9-characters
# Optional until a Zabbix connection is configured:
ZABBIX_API_TOKEN=
APP_HOST=127.0.0.1
APP_PORT=8000
# Set to 1 only when serving behind HTTPS:
APP_HTTPS=0
# For compose.cert.yaml use a DNS hostname covered by the certificate, not an IP:
APP_DOMAIN=
# Display timezone for the activity log and client-side timestamps:
APP_TIMEZONE=Europe/Tallinn
# Optional when OLT SNMP community is a Zabbix macro (literal communities are read from interfaces):
ONU_SNMP_COMMUNITY=
