# Copy to .env and set unique values. .env is ignored by Git.
APP_SECRET_KEY=replace-with-at-least-32-random-characters
ADMIN_PASSWORD=replace-with-at-least-12-characters
# Optional until a Zabbix connection is configured:
ZABBIX_API_TOKEN=
APP_HOST=127.0.0.1
APP_PORT=8000
# Set to 1 only when serving behind HTTPS:
APP_HTTPS=0
# Hostname or public IP used in the browser (for example monitor.example.com):
APP_DOMAIN=
